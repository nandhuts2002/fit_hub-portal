{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "server/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/trainer/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/shop/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/exercises/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/location/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/live/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/community/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/profile/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/proxy/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "client/static/$1"
    },
    {
      "src": "/(.*\\.(js|css|json|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot))",
      "dest": "client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "client/index.html"
    }
  ]
}
