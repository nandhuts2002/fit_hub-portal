# RapidAPI ExerciseDB API Key
# Get your API key from: https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
REACT_APP_RAPIDAPI_KEY=your_rapidapi_key_here

# Image Proxy URL (optional - defaults to localhost:5001)
REACT_APP_IMAGE_PROXY_URL=http://localhost:5001

# AI Workout Planner (RapidAPI) configuration
# Many providers exist on RapidAPI. Provide the host and full URL for the endpoint you plan to call.
# Examples:
#   REACT_APP_RAPIDAPI_HOST=ai-workout-planner.p.rapidapi.com
#   REACT_APP_RAPIDAPI_URL=https://ai-workout-planner.p.rapidapi.com/plan
# Or for a generic text-generation-like endpoint you control via RapidAPI:
#   REACT_APP_RAPIDAPI_HOST=your-provider.p.rapidapi.com
#   REACT_APP_RAPIDAPI_URL=https://your-provider.p.rapidapi.com/generate
# HTTP method can be POST or GET depending on the API; default is POST.
REACT_APP_RAPIDAPI_HOST=
REACT_APP_RAPIDAPI_URL=
REACT_APP_RAPIDAPI_METHOD=POST

# Advanced Calorie Calculator API (RapidAPI)
# Get your API key from: https://rapidapi.com/
REACT_APP_CALORIE_API_KEY=your_rapidapi_key_here
REACT_APP_CALORIE_API_HOST=advanced-calorie-calculator-api.p.rapidapi.com
REACT_APP_CALORIE_API_URL=https://advanced-calorie-calculator-api.p.rapidapi.com
